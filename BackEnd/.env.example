# ─── Environnement ───────────────────────────────────────────
NODE_ENV=production

# ─── Base de données (TiDB Cloud) ────────────────────────────
DB_TYPE=mysql
DB_HOST=gateway01.eu-central-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=<tidb-username>
DB_PASSWORD=<tidb-password>
DB_DATABASE=innovsahel_db
DB_SSL=true

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET=<chaine-aleatoire-longue-et-secrete>
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=<autre-chaine-aleatoire-longue-et-secrete>
JWT_REFRESH_EXPIRES_IN=7d

# ─── Frontend (CORS) ─────────────────────────────────────────
# Plusieurs URLs séparées par des virgules si nécessaire
FRONTEND_URL=https://innov-sahel.vercel.app,https://innov-sahel-git-main-username.vercel.app

# ─── Upload de fichiers (Cloudinary pour persistance cloud) ───
CLOUDINARY_CLOUD_NAME=<votre-cloud-name>
CLOUDINARY_API_KEY=<votre-api-key>
CLOUDINARY_API_SECRET=<votre-api-secret>
UPLOAD_DEST=./uploads

# ─── Mail (optionnel) ─────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=<votre-email@gmail.com>
MAIL_PASSWORD=<app-password-gmail>
MAIL_FROM=InnovSahel <noreply@innovsahel.org>

# ─── Seed Admin (premier déploiement) ────────────────────────
ADMIN_1_EMAIL=admin@bamako.ml
ADMIN_1_PASSWORD=<mot-de-passe-fort>
ADMIN_1_NAME=Administrateur Bamako
SUPER_ADMIN_EMAIL=superadmin@innovsahel.org
SUPER_ADMIN_PASSWORD=<mot-de-passe-fort>
