# ========================================================
# InnovSahel Backend — Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs
# ========================================================

# --- Serveur ---
PORT=3001
NODE_ENV=development

# --- Base de données (MySQL / phpMyAdmin) ---
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=innovsahel_db
# Optionnel SQLite :
# DB_TYPE=sqljs
# DB_DATABASE=./innovsahel.db

# --- JWT ---
JWT_SECRET=ChangezCeSecretEnProduction_utilisez_openssl_rand_base64_64
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=AutreSecretPourRefreshToken_utilisez_openssl_rand_base64_64
JWT_REFRESH_EXPIRES_IN=7d

# --- Comptes Admin (seeding initial) ---
ADMIN_1_NAME=Moussa Cissé
ADMIN_1_EMAIL=moussa.cisse@impactsahel.org
ADMIN_1_PHONE=+223 20 23 45 67
ADMIN_1_PASSWORD=Admin1_TempPass2025!
ADMIN_2_NAME=Aminata Traoré
ADMIN_2_EMAIL=aminata.traore@impactsahel.org
ADMIN_2_PHONE=+223 70 12 34 56
ADMIN_2_PASSWORD=Admin2_TempPass2025!

# --- Email (Nodemailer) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=votre.email@gmail.com
MAIL_PASSWORD=VotreMotDePasseApp
MAIL_FROM="InnovSahel <noreply@innovsahel.org>"
# Emails destinataires des notifications (séparés par des virgules)
ADMIN_NOTIFICATION_EMAILS=moussa.cisse@impactsahel.org,aminata.traore@impactsahel.org

# --- Uploads ---
UPLOAD_DEST=./uploads
MAX_FILE_SIZE_MB=5

# --- Frontend ---
FRONTEND_URL=http://localhost:3000
